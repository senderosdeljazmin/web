# ============================================
# Cache de archivos estáticos (Apache / mod_expires + mod_headers)
# Tiempos cortos porque el contenido se actualiza semanalmente
# Colócalo en la raíz del sitio, junto a index.html
# ============================================

<IfModule mod_expires.c>
  ExpiresActive On

  # Imágenes: 3 días. Suficiente para que un visitante que vuelve
  # en la misma semana no las vuelva a descargar, pero se refrescan rápido.
  ExpiresByType image/webp "access plus 3 days"
  ExpiresByType image/jpeg "access plus 3 days"
  ExpiresByType image/png  "access plus 3 days"
  ExpiresByType image/svg+xml "access plus 3 days"
  ExpiresByType image/x-icon "access plus 3 days"

  # CSS / JS: 1 día
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"

  # Fuentes: estas casi nunca cambian, se dejan más largas
  ExpiresByType font/woff2 "access plus 1 month"
  ExpiresByType font/woff "access plus 1 month"

  # PDFs: 1 día
  ExpiresByType application/pdf "access plus 1 day"

  # HTML: siempre se revisa (nunca se cachea), para que el usuario
  # vea de inmediato cualquier cambio de contenido o estructura.
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=259200"
  </FilesMatch>
  <FilesMatch "\.(css|js|pdf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ============================================
# Compresión Gzip (reduce peso de transferencia, no afecta al caché)
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
